default_platform(:ios)

require_relative "FastlaneEnv"

platform :ios do
  before_all do
    # Load App Store Connect API key if available (CI)
    if ENV["APP_STORE_CONNECT_P8_PATH"] || ENV["APP_STORE_CONNECT_API_KEY_PATH"]
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_filepath: ENV["APP_STORE_CONNECT_P8_PATH"] || ENV["APP_STORE_CONNECT_API_KEY_PATH"],
        duration: 1200,
        in_house: false
      )
    end
  end

  desc "Run unit tests"
  lane :test do
    run_tests(
      project: "FastTrack.xcodeproj",
      scheme: "FastTrack",
      devices: ["iPhone 17 Pro"],
      code_coverage: true,
      output_directory: "fastlane/test_output"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    build_keychain_name = "fasttrack-fastlane.keychain-db"
    build_keychain_password = ENV["FASTLANE_KEYCHAIN_PASSWORD"] || "fasttrack-fastlane"

    create_keychain(
      name: build_keychain_name,
      password: build_keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Sync distribution certificates and provisioning profiles
    match(
      type: "appstore",
      readonly: is_ci,
      keychain_name: build_keychain_name,
      keychain_password: build_keychain_password
    )

    # Build number: unique per build (second granularity)
    build_number = Time.now.strftime("%Y%m%d%H%M%S")
    marketing_version = ENV["FL_VERSION_NUMBER"]

    # Build the app
    xcargs = "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution'"
    xcargs += " CURRENT_PROJECT_VERSION=#{build_number}"
    xcargs += " MARKETING_VERSION=#{marketing_version}" if marketing_version

    build_app(
      project: "FastTrack.xcodeproj",
      scheme: "FastTrack",
      configuration: "Release",
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      xcargs: xcargs,
      skip_profile_detection: true,
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          "com.toper.FastTrack" => "match AppStore com.toper.FastTrack",
          "com.toper.FastTrack.FastTrackWidgets" => "com.toper.FastTrack.FastTrackWidgets AppStore"
        }
      },
      output_directory: "fastlane/builds",
      output_name: "FastTrack.ipa"
    )

    changelog = ENV["FL_WHATS_NEW"].to_s.empty? ? nil : ENV["FL_WHATS_NEW"]

    # Upload to TestFlight (no submit for review)
    changelog = ENV["FL_WHATS_NEW"].to_s.empty? ? nil : ENV["FL_WHATS_NEW"]
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      notify_external_testers: false,
      changelog: changelog
    )
  end

  desc "Submit to App Store for review"
  lane :release do
    match(type: "appstore", readonly: is_ci)

    build_app(
      project: "FastTrack.xcodeproj",
      scheme: "FastTrack",
      configuration: "Release",
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution'",
      skip_profile_detection: true,
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          "com.toper.FastTrack" => "match AppStore com.toper.FastTrack",
          "com.toper.FastTrack.FastTrackWidgets" => "com.toper.FastTrack.FastTrackWidgets AppStore"
        }
      }
    )

    upload_to_app_store(
      submit_for_review: true,
      automatic_release: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  error do |lane, exception|
    UI.error("Lane #{lane} failed with #{exception.message}")
  end
end
