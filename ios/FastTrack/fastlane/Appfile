fastlane_env = [
  File.expand_path("FastlaneEnv.rb", __dir__),
  File.expand_path("fastlane/FastlaneEnv.rb", Dir.pwd)
].find { |path| File.exist?(path) }
load fastlane_env if fastlane_env

app_identifier fastlane_env!("FASTTRACK_APP_IDENTIFIER")
apple_id fastlane_env!("APPLE_ID")
team_id fastlane_env!("TEAM_ID")

optional_itc_team_id = ENV["ITC_TEAM_ID"].to_s
itc_team_id optional_itc_team_id unless optional_itc_team_id.empty?
